{
  "name": "@plog/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./src/styles/index.css",
    "./styles/font": "./src/styles/font.css",
    "./tokens": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -b && vite build",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@plog/utils": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "pretendard": "^1.3.9",
    "swiper": "^12.1.3",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5",
    "@eslint/js": "^9",
    "@plog/config": "workspace:*",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10",
    "@storybook/react": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "chromatic": "^16.1.0",
    "eslint": "^9",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^10",
    "typescript": "^5.8",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vite-plugin-svgr": "^5.2.0"
  }
}
